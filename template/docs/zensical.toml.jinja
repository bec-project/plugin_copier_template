# From the repository root, install documentation dependencies:
# python -m pip install -e '.[docs]'
# Then run these commands from docs/:
# Preview locally: zensical serve
# Build the static site in docs/site/: zensical build --strict
# Configuration reference: https://zensical.org/docs/setup/basics/

[project]
site_name = {{ project_name | tojson }}
# Fill in the published documentation URL when hosting is configured.
site_url = ""
site_description = {{ ("User and developer documentation for " ~ project_name) | tojson }}
site_author = "Paul Scherrer Institute"
repo_url = {{ ("https://gitea.psi.ch/bec/" ~ project_name) | tojson }}
repo_name = {{ ("bec/" ~ project_name) | tojson }}
copyright = "Copyright &copy; Paul Scherrer Institute"
docs_dir = "."
site_dir = "site"
extra_css = ["stylesheets/extra.css"]
use_directory_urls = false
exclude_docs = """
/zensical.toml
/site/
/.cache/
/plans/
/_build/
*.log
/objects.inv
"""
nav = [
  { "Home" = "index.md" },
  { "Introduction" = "introduction/introduction.md" },
  { "Safety" = "safety/safety.md" },
  { "User guide" = [
    { "Overview" = "user/user.md" },
    { "Before you arrive" = "user/before_you_arrive/before_you_arrive.md" },
    { "Data analysis" = [
      { "Overview" = "user/data_analysis/data_analysis.md" },
      { "Computing" = "user/data_analysis/computing.md" },
    ] },
  ] },
  { "Developer guide" = [
    { "Overview" = "developer/developer.md" },
    { "Editing the documentation" = "developer/editing_docs.md" },
  ] },
]

[project.theme]
language = "en"
features = ["navigation.tabs", "navigation.sections", "navigation.top", "content.code.copy", "search.highlight"]

[[project.theme.palette]]
media = "(prefers-color-scheme)"
toggle.icon = "lucide/sun-moon"
toggle.name = "Switch to light mode"

[[project.theme.palette]]
media = "(prefers-color-scheme: light)"
scheme = "default"
toggle.icon = "lucide/sun"
toggle.name = "Switch to dark mode"

[[project.theme.palette]]
media = "(prefers-color-scheme: dark)"
scheme = "slate"
toggle.icon = "lucide/moon"
toggle.name = "Switch to system preference"

[project.markdown_extensions.admonition]
[project.markdown_extensions.attr_list]
[project.markdown_extensions.md_in_html]
[project.markdown_extensions.pymdownx.betterem]
smart_enable = "all"
[project.markdown_extensions.pymdownx.highlight]
[project.markdown_extensions.pymdownx.keys]
[project.markdown_extensions.pymdownx.superfences]
[project.markdown_extensions.pymdownx.tabbed]
alternate_style = true
[project.markdown_extensions.pymdownx.tasklist]
custom_checkbox = true
[project.markdown_extensions.toc]
permalink = true
